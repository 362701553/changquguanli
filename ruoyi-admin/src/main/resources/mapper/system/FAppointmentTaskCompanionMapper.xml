<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.FAppointmentTaskCompanionMapper">

    <resultMap type="com.ruoyi.system.domain.FAppointmentTaskCompanion" id="CompanionResult">
        <result property="id" column="id" />
        <result property="taskId" column="task_id" />
        <result property="name" column="name" />
        <result property="country" column="country" />
        <result property="phone" column="phone" />
        <result property="idCardLastFour" column="id_card_last_four" />
        <result property="createDate" column="create_date" />
    </resultMap>

    <insert id="insertFAppointmentTaskCompanion" parameterType="com.ruoyi.system.domain.FAppointmentTaskCompanion" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO f_appointment_task_companion (task_id, name, country, phone, id_card_last_four, create_date)
        VALUES (#{taskId}, #{name}, #{country}, #{phone}, #{idCardLastFour}, #{createDate})
    </insert>

    <select id="selectByTaskId" parameterType="Long" resultMap="CompanionResult">
        SELECT id, task_id, name, country, phone, id_card_last_four, create_date
        FROM f_appointment_task_companion
        WHERE task_id = #{taskId}
        ORDER BY id ASC
    </select>

    <delete id="deleteByTaskId" parameterType="Long">
        DELETE FROM f_appointment_task_companion WHERE task_id = #{taskId}
    </delete>

</mapper>
