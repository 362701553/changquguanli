        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deleted"    column="deleted"    />
        <result property="taskId"    column="task_id"    />
        <result property="taskCode"    column="task_code"    />
    </resultMap>

    <sql id="selectFLocationDeviceVo">
        select id, device_sn, rfid_tag, device_status, status, scrap_reason, rfid_bind_status,
               device_category_id, device_category, battery_level, frequency, battery_status,
               last_battery_update, product_sn, product_model, product_name, area_location,
               storage_location, dept_id, dept_name, factory_id, factory_code, factory_name,
               area_id, area_name, remark1, remark2, remark3, create_by, create_time,
               update_by, update_time, deleted, task_id, task_code
        from f_location_device
    </sql>

    <select id="selectFLocationDeviceList" parameterType="FLocationDevice" resultMap="FLocationDeviceResult">
        <include refid="selectFLocationDeviceVo"/>
        <where>
            <if test="deviceSn != null and deviceSn != ''"> and device_sn like concat('%', #{deviceSn}, '%')</if>
            <if test="rfidTag != null and rfidTag != ''"> and rfid_tag like concat('%', #{rfidTag}, '%')</if>
            <if test="deviceStatus != null and deviceStatus != ''"> and device_status = #{deviceStatus}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="rfidBindStatus != null and rfidBindStatus != ''"> and rfid_bind_status = #{rfidBindStatus}</if>
            <if test="deviceCategoryId != null"> and device_category_id = #{deviceCategoryId}</if>
            <if test="deviceCategory != null and deviceCategory != ''"> and device_category like concat('%', #{deviceCategory}, '%')</if>
            <if test="batteryStatus != null and batteryStatus != ''"> and battery_status = #{batteryStatus}</if>
            <if test="productModel != null and productModel != ''"> and product_model like concat('%', #{productModel}, '%')</if>
            <if test="productName != null and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="deptId != null"> and dept_id = #{deptId}</if>
            <if test="factoryId != null and factoryId != ''"> and factory_id = #{factoryId}</if>
            <if test="factoryName != null and factoryName != ''"> and factory_name like concat('%', #{factoryName}, '%')</if>
            <if test="areaId != null"> and area_id = #{areaId}</if>
            <if test="areaName != null and areaName != ''"> and area_name like concat('%', #{areaName}, '%')</if>
            <if test="deleted != null"> and deleted = #{deleted}</if>
            <if test="taskId != null"> and task_id = #{taskId}</if>
            and deleted = 0
        </where>
    </select>

    <select id="selectFLocationDeviceById" parameterType="Long" resultMap="FLocationDeviceResult">
        <include refid="selectFLocationDeviceVo"/>
        where id = #{id}
    </select>

    <select id="selectAvailableDevices" parameterType="FLocationDevice" resultMap="FLocationDeviceResult">
        <include refid="selectFLocationDeviceVo"/>
        where status = 1 and device_status = 'idle' and deleted = 0
        <if test="deviceSn != null and deviceSn != ''"> and device_sn like concat('%', #{deviceSn}, '%')</if>
        <if test="productName != null and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
    </select>

    <insert id="insertFLocationDevice" parameterType="FLocationDevice" useGeneratedKeys="true" keyProperty="id">
        insert into f_location_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceSn != null and deviceSn != ''">device_sn,</if>
            <if test="rfidTag != null">rfid_tag,</if>
            <if test="deviceStatus != null">device_status,</if>
            <if test="status != null">status,</if>
            <if test="scrapReason != null">scrap_reason,</if>
            <if test="rfidBindStatus != null">rfid_bind_status,</if>
            <if test="deviceCategoryId != null">device_category_id,</if>
            <if test="deviceCategory != null">device_category,</if>
            <if test="batteryLevel != null">battery_level,</if>
            <if test="frequency != null">frequency,</if>
            <if test="batteryStatus != null">battery_status,</if>
