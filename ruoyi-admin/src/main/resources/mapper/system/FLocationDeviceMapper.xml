<mapper namespace="com.ruoyi.system.mapper.FLocationDeviceMapper">

    <resultMap type="FLocationDevice" id="FLocationDeviceResult">
        <result property="id"    column="id"    />
        <result property="deviceSn"    column="device_sn"    />
        <result property="rfidTag"    column="rfid_tag"    />
