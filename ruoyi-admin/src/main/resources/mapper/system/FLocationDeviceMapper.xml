    </update>

    <delete id="deleteFLocationDeviceById" parameterType="Long">
        delete from f_location_device where id = #{id}
    </delete>

    <delete id="deleteFLocationDeviceByIds" parameterType="String">
        delete from f_location_device where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
