            <if test="productSn != null">product_sn,</if>
            <if test="productModel != null">product_model,</if>
            <if test="productName != null">product_name,</if>
            <if test="areaLocation != null">area_location,</if>
            <if test="storageLocation != null">storage_location,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="factoryId != null">factory_id,</if>
            <if test="factoryCode != null">factory_code,</if>
            <if test="factoryName != null">factory_name,</if>
            <if test="areaId != null">area_id,</if>
            <if test="areaName != null">area_name,</if>
            <if test="remark1 != null">remark1,</if>
            <if test="remark2 != null">remark2,</if>
            <if test="remark3 != null">remark3,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deleted != null">deleted,</if>
            <if test="taskId != null">task_id,</if>
            <if test="taskCode != null">task_code,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceSn != null and deviceSn != ''">#{deviceSn},</if>
            <if test="rfidTag != null">#{rfidTag},</if>
            <if test="deviceStatus != null">#{deviceStatus},</if>
            <if test="status != null">#{status},</if>
