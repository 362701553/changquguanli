            <if test="lastBatteryUpdate != null">#{lastBatteryUpdate},</if>
            <if test="productSn != null">#{productSn},</if>
            <if test="productModel != null">#{productModel},</if>
            <if test="productName != null">#{productName},</if>
            <if test="areaLocation != null">#{areaLocation},</if>
            <if test="storageLocation != null">#{storageLocation},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="factoryId != null">#{factoryId},</if>
            <if test="factoryCode != null">#{factoryCode},</if>
            <if test="factoryName != null">#{factoryName},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="areaName != null">#{areaName},</if>
            <if test="remark1 != null">#{remark1},</if>
            <if test="remark2 != null">#{remark2},</if>
            <if test="remark3 != null">#{remark3},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="taskCode != null">#{taskCode},</if>
        </trim>
    </insert>

    <update id="updateFLocationDevice" parameterType="FLocationDevice">
        update f_location_device
        <trim prefix="SET" suffixOverrides=",">
