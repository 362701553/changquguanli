<mapper namespace="com.ruoyi.system.mapper.FDockMapper">
    
    <resultMap type="FDock" id="FDockResult">
        <result property="id"    column="id"    />
        <result property="dockCode"    column="dock_code"    />
        <result property="dockName"    column="dock_name"    />
        <result property="areaId"    column="area_id"    />
        <result property="areaName"    column="area_name"    />
        <result property="unloadingDuration"    column="unloading_duration"    />
        <result property="loadingDuration"    column="loading_duration"    />
        <result property="workDays"    column="work_days"    />
        <result property="coordinate"    column="coordinate"    />
        <result property="factoryId"    column="factory_id"    />
        <result property="factoryName"    column="factory_name"    />
        <result property="deptId"    column="dept_id"    />
        <result property="itselfDeptId"    column="itself_dept_id"    />
        <result property="status"    column="status"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="loadingPointCount"    column="loading_point_count"    />
        <result property="parkingSpaceCount"    column="parking_space_count"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createDate"    column="create_date"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateDate"    column="update_date"    />
        <result property="deleted"    column="deleted"    />
        <result property="parentId"    column="parent_id"    />
        <result property="forkliftWork"    column="forklift_work"    />
    </resultMap>

    <sql id="selectFDockVo">
        select id, dock_code, dock_name, area_id, area_name, unloading_duration, loading_duration, work_days, coordinate, factory_id, factory_name, dept_id, itself_dept_id, status, sort_order, loading_point_count, parking_space_count, description, create_by, create_date, update_by, update_date, deleted, parent_id, forklift_work from f_dock
    </sql>

    <select id="selectFDockList" parameterType="FDock" resultMap="FDockResult">
        <include refid="selectFDockVo"/>
        <where>  
            <if test="dockCode != null  and dockCode != ''"> and dock_code = #{dockCode}</if>
            <if test="dockName != null  and dockName != ''"> and dock_name like concat('%', #{dockName}, '%')</if>
            <if test="areaId != null "> and area_id = #{areaId}</if>
            <if test="areaName != null  and areaName != ''"> and area_name like concat('%', #{areaName}, '%')</if>
            <if test="unloadingDuration != null "> and unloading_duration = #{unloadingDuration}</if>
            <if test="loadingDuration != null "> and loading_duration = #{loadingDuration}</if>
            <if test="workDays != null  and workDays != ''"> and work_days = #{workDays}</if>
            <if test="coordinate != null  and coordinate != ''"> and coordinate = #{coordinate}</if>
            <if test="factoryId != null "> and factory_id = #{factoryId}</if>
            <if test="factoryName != null  and factoryName != ''"> and factory_name like concat('%', #{factoryName}, '%')</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="itselfDeptId != null "> and itself_dept_id = #{itselfDeptId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
            <if test="loadingPointCount != null "> and loading_point_count = #{loadingPointCount}</if>
            <if test="parkingSpaceCount != null "> and parking_space_count = #{parkingSpaceCount}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="createDate != null "> and create_date = #{createDate}</if>
            <if test="updateDate != null "> and update_date = #{updateDate}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="forkliftWork != null "> and forklift_work = #{forkliftWork}</if>
        </where>
    </select>
    
    <select id="selectFDockById" parameterType="Long" resultMap="FDockResult">
        <include refid="selectFDockVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertFDock" parameterType="FDock" useGeneratedKeys="true" keyProperty="id">
        insert into f_dock
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dockCode != null">dock_code,</if>
            <if test="dockName != null">dock_name,</if>
            <if test="areaId != null">area_id,</if>
            <if test="areaName != null">area_name,</if>
            <if test="unloadingDuration != null">unloading_duration,</if>
            <if test="loadingDuration != null">loading_duration,</if>
            <if test="workDays != null">work_days,</if>
            <if test="coordinate != null">coordinate,</if>
            <if test="factoryId != null">factory_id,</if>
            <if test="factoryName != null">factory_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="itselfDeptId != null">itself_dept_id,</if>
            <if test="status != null">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="loadingPointCount != null">loading_point_count,</if>
            <if test="parkingSpaceCount != null">parking_space_count,</if>
            <if test="description != null">description,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createDate != null">create_date,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="deleted != null">deleted,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="forkliftWork != null">forklift_work,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dockCode != null">#{dockCode},</if>
            <if test="dockName != null">#{dockName},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="areaName != null">#{areaName},</if>
            <if test="unloadingDuration != null">#{unloadingDuration},</if>
            <if test="loadingDuration != null">#{loadingDuration},</if>
            <if test="workDays != null">#{workDays},</if>
            <if test="coordinate != null">#{coordinate},</if>
            <if test="factoryId != null">#{factoryId},</if>
            <if test="factoryName != null">#{factoryName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="itselfDeptId != null">#{itselfDeptId},</if>
            <if test="status != null">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="loadingPointCount != null">#{loadingPointCount},</if>
            <if test="parkingSpaceCount != null">#{parkingSpaceCount},</if>
            <if test="description != null">#{description},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateDate != null">#{updateDate},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="forkliftWork != null">#{forkliftWork},</if>
         </trim>
    </insert>

    <update id="updateFDock" parameterType="FDock">
        update f_dock
        <trim prefix="SET" suffixOverrides=",">
            <if test="dockCode != null">dock_code = #{dockCode},</if>
            <if test="dockName != null">dock_name = #{dockName},</if>
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="areaName != null">area_name = #{areaName},</if>
            <if test="unloadingDuration != null">unloading_duration = #{unloadingDuration},</if>
            <if test="loadingDuration != null">loading_duration = #{loadingDuration},</if>
            <if test="workDays != null">work_days = #{workDays},</if>
            <if test="coordinate != null">coordinate = #{coordinate},</if>
            <if test="factoryId != null">factory_id = #{factoryId},</if>
            <if test="factoryName != null">factory_name = #{factoryName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="itselfDeptId != null">itself_dept_id = #{itselfDeptId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="loadingPointCount != null">loading_point_count = #{loadingPointCount},</if>
            <if test="parkingSpaceCount != null">parking_space_count = #{parkingSpaceCount},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
