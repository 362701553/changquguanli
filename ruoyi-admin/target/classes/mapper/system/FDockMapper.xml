    <delete id="deleteFDockById" parameterType="Long">
        delete from f_dock where id = #{id}
    </delete>

    <delete id="deleteFDockByIds" parameterType="String">
        delete from f_dock where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>