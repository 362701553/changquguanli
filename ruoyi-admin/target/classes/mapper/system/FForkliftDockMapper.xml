<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.FForkliftDockMapper">
    
    <resultMap type="FForkliftDock" id="FForkliftDockResult">
        <result property="myRowId"    column="my_row_id"    />
        <result property="forkliftId"    column="forklift_id"    />
        <result property="dockId"    column="dock_id"    />
        <result property="dockName"    column="dock_name"    />
        <result property="forkliftCode"    column="forklift_code"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectFForkliftDockVo">
        select my_row_id, forklift_id, dock_id, dock_name, forklift_code, status from f_forklift_dock
    </sql>

    <select id="selectFForkliftDockList" parameterType="FForkliftDock" resultMap="FForkliftDockResult">
        <include refid="selectFForkliftDockVo"/>
        <where>  
            <if test="forkliftId != null "> and forklift_id = #{forkliftId}</if>
            <if test="dockId != null "> and dock_id = #{dockId}</if>
            <if test="dockName != null  and dockName != ''"> and dock_name like concat('%', #{dockName}, '%')</if>
            <if test="forkliftCode != null  and forkliftCode != ''"> and forklift_code = #{forkliftCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectFForkliftDockByMyRowId" parameterType="String" resultMap="FForkliftDockResult">
        <include refid="selectFForkliftDockVo"/>
        where my_row_id = #{myRowId}
    </select>
        
    <insert id="insertFForkliftDock" parameterType="FForkliftDock">
        insert into f_forklift_dock
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="myRowId != null">my_row_id,</if>
            <if test="forkliftId != null">forklift_id,</if>
            <if test="dockId != null">dock_id,</if>
            <if test="dockName != null">dock_name,</if>
            <if test="forkliftCode != null">forklift_code,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="myRowId != null">#{myRowId},</if>
            <if test="forkliftId != null">#{forkliftId},</if>
            <if test="dockId != null">#{dockId},</if>
            <if test="dockName != null">#{dockName},</if>
            <if test="forkliftCode != null">#{forkliftCode},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateFForkliftDock" parameterType="FForkliftDock">
        update f_forklift_dock
        <trim prefix="SET" suffixOverrides=",">
            <if test="forkliftId != null">forklift_id = #{forkliftId},</if>
            <if test="dockId != null">dock_id = #{dockId},</if>
            <if test="dockName != null">dock_name = #{dockName},</if>
            <if test="forkliftCode != null">forklift_code = #{forkliftCode},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where my_row_id = #{myRowId}
    </update>

    <delete id="deleteFForkliftDockByMyRowId" parameterType="String">
        delete from f_forklift_dock where my_row_id = #{myRowId}
    </delete>

    <delete id="deleteFForkliftDockByMyRowIds" parameterType="String">
        delete from f_forklift_dock where my_row_id in 
        <foreach item="myRowId" collection="array" open="(" separator="," close=")">
            #{myRowId}
        </foreach>
    </delete>
</mapper>